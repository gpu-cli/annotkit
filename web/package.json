{
  "name": "annotkit-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Landing page for AnnotKit — annotkit.gpu-cli.sh",
  "scripts": {
    "dev": "vite",
    "dev:functions": "wrangler pages dev --proxy 5173 -- npm run dev",
    "build": "npm run fonts && npm run typecheck && vite build",
    "preview": "vite preview",
    "fonts": "node scripts/sync-fonts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist --project-name annotkit --branch main",
    "lighthouse": "lhci autorun",
    "og": "npm run fonts && node scripts/og.mjs",
    "responsive": "node scripts/responsive-check.mjs",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name annotkit --branch preview"
  },
  "dependencies": {
    "posthog-js-lite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/newsreader": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@lhci/cli": "^0.15.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.124.0"
  }
}
